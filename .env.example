# Autonomous Worker Environment Configuration Template
# Copy this file to .env.local or set via container environment variables

# Server & Dashboard Configuration
WORKER_PORT=8888
WORKER_HOST=0.0.0.0
WORKER_CONFIG_PATH=/var/www/worker/config.json
WORKER_DB_PATH=/var/www/worker/data/worker.db

# LLM Inference Backend (Ollama)
OLLAMA_URL=http://127.0.0.1:11434

# Security Governance
ENFORCE_IP_WHITELIST=true
SESSION_MAX_AGE_SECONDS=604800
DEFAULT_ADMIN_USER=admin
