#!/usr/bin/env bash
# Autonomous Worker Credential Guard Pre-Push Hook
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON_EXEC="python3"

if ! command -v python3 &>/dev/null; then
    PYTHON_EXEC="python"
fi

echo "[CREDENTIAL-GUARD] Verifying repository safety before push to remote..."
"$PYTHON_EXEC" "$REPO_ROOT/tools/credential_guard.py" scan-all
