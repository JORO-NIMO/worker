#!/usr/bin/env bash
# Autonomous Worker Credential Guard Pre-Commit Hook
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON_EXEC="python3"

if ! command -v python3 &>/dev/null; then
    PYTHON_EXEC="python"
fi

echo "[CREDENTIAL-GUARD] Scanning staged files for accidental secrets & credentials..."
"$PYTHON_EXEC" "$REPO_ROOT/tools/credential_guard.py" scan-git
